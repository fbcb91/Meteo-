{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/page.js": { "includeFiles": "{page.html,data/**}" },
    "api/sitemap.js": { "includeFiles": "data/**" },
    "api/place.js": { "includeFiles": "data/**" }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/page" },
    { "source": "/meteo", "destination": "/api/page?view=directory" },
    { "source": "/meteo/:slug", "destination": "/api/page?slug=:slug" },
    { "source": "/regioni/:region", "destination": "/api/page?region=:region" },
    { "source": "/come-funziona", "destination": "/api/page?view=come-funziona" },
    { "source": "/privacy", "destination": "/api/page?view=privacy" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/sitemap?robots=1" },
    { "source": "/((?!api/).*)", "destination": "/api/page?view=404" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/page.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tilecache.rainviewer.com; font-src 'self'; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com https://air-quality-api.open-meteo.com https://marine-api.open-meteo.com https://api.rainviewer.com https://api.bigdatacloud.net; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    },
    { "source": "/(fonts|vendor|icons)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(app.js|styles.css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] }
  ]
}
